# Discord Exporter Configuration
# Copy this file to ~/.discord-exporter/.env and fill in your values

# Your Discord token (NEVER share this with anyone!)
DISCORD_TOKEN="your-discord-token-here"

# Path to DiscordChatExporter.Cli executable
# macOS (Apple Silicon): ~/Downloads/DiscordChatExporter.Cli.osx-arm64/DiscordChatExporter.Cli
# macOS (Intel): ~/Downloads/DiscordChatExporter.Cli.osx-x64/DiscordChatExporter.Cli
# Linux: ~/Downloads/DiscordChatExporter.Cli.linux-x64/DiscordChatExporter.Cli
# Windows: C:\Tools\DiscordChatExporter\DiscordChatExporter.Cli.exe
DCE_PATH="path/to/DiscordChatExporter.Cli"
